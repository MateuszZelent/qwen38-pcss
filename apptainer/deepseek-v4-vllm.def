Bootstrap: docker
From: vllm/vllm-openai:nightly

# DeepSeek-V4-Pro-0813 requires vLLM >= 0.25.0. The nightly image is used for
# the initial PCSS qualification because DeepSeek V4 and DSpark are new. Pin a
# known-good image digest after the first successful end-to-end run.

%labels
    APP_NAME deepseek-v4-pro-vllm
    MODEL_ID deepseek-ai/DeepSeek-V4-Pro-0813
    API OpenAI
    RUNTIME vLLM
    GPU_INTERFACE Apptainer-nv

%environment
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false
    export HF_HUB_DISABLE_TELEMETRY=1
    export VLLM_USAGE_SOURCE=production
    export VLLM_WORKER_MULTIPROC_METHOD=spawn
    export HF_HOME=${HF_HOME:-/models/.cache}

%post
    set -eux
    mkdir -p /models /workspace /opt/deepseek-v4
    python3 - <<'PY'
import importlib.metadata
import torch
import vllm

print("vLLM:", vllm.__version__)
print("PyTorch:", torch.__version__)
print("CUDA compiled:", torch.version.cuda)
print("huggingface-hub:", importlib.metadata.version("huggingface-hub"))
PY

%test
    python3 - <<'PY'
from packaging.version import Version
import vllm

assert Version(vllm.__version__.split("+")[0]) >= Version("0.25.0")
print("DeepSeek V4 runtime OK:", vllm.__version__)
PY

%runscript
    exec vllm serve "$@"
