# Copy to config/pcss.env and replace every infrastructure-specific value.
# Use absolute paths. MODEL_ROOT must be visible from the compute node.

MODEL_ID=Qwen/Qwen3.8-27B
MODEL_SUBDIR=Qwen3.8-27B
MODEL_ROOT=/scratch/REPLACE_ME/qwen38

# SIF path. This can be in the project directory or on PCSS storage.
SIF=/scratch/REPLACE_ME/qwen38/qwen38-vllm.sif

# vLLM listens only on the compute node loopback by default.
SERVER_HOST=127.0.0.1
REMOTE_PORT=8000
LOCAL_PORT=18000
MODEL_NAME=qwen3.8-27b

# Full-power single-user profile: 1.01M context, BF16 weights and BF16 KV cache
# across four H100 94 GiB GPUs. The nested override follows the official vLLM
# Qwen3.8 recipe; MTP uses the checkpoint's built-in draft head.
MAX_MODEL_LEN=1010000
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.95
TENSOR_PARALLEL_SIZE=4
DTYPE=bfloat16
HF_OVERRIDES='{"text_config":{"max_position_embeddings":1010000}}'
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'

# Qwen tool-calling / reasoning parsers used by vLLM.
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3

# Optional flags. Leave empty for the first boot if the selected vLLM build
# rejects them. Examples: fp8, fp8_e4m3.
KV_CACHE_DTYPE=auto
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
MAX_NUM_BATCHED_TOKENS=

# Optional override if the cluster exposes the runtime under a non-standard
# command. Normally serve-local.sh detects apptainer or singularity itself.
# CONTAINER_RUNTIME=singularity

# Optional: used only by download-model.sh when the model requires auth.
# Do not put the token in this file or commit it.
# HF_TOKEN=
