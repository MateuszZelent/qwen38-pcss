# Nie wklejaj tego pliku ręcznie. Router generuje blok zarządzany w
# ~/.codex/config.toml i zachowuje poprzednie ustawienia w kopii zapasowej.
# Uruchom:
#   PowerShell: .\scripts\setup-codex-router.ps1
#   WSL/Linux:  ./scripts/setup-codex-router.sh

model_provider = "codex_shim"

[model_providers.codex_shim]
name = "Codex Shim"
base_url = "http://127.0.0.1:8765/v1"
wire_api = "responses"
experimental_bearer_token = "dummy"
