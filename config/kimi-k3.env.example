# Copy to config/kimi-k3.env on PCSS. Keep the real file untracked.
# Kimi-K3 MXFP4 is about 1.68 TB. PCSS 4xH100 nodes require at least 8 nodes.

MODEL_ID=moonshotai/Kimi-K3
MODEL_SUBDIR=Kimi-K3
MODEL_ROOT=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/models
SIF=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/kimi-k3-vllm.sif

MODEL_NAME=kimi-k3
SERVER_HOST=127.0.0.1
REMOTE_PORT=8002
LOCAL_PORT=18002
DP_RPC_PORT=13346

GPUS_PER_NODE=4
MIN_NODES=8
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=5
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.97
DTYPE=auto

ENABLE_EXPERT_PARALLEL=1
ALL2ALL_BACKEND=deepep_v2
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=kimi_k3
REASONING_PARSER=kimi_k3
LANGUAGE_MODEL_ONLY=1
MOE_BACKEND=marlin
ATTENTION_BACKEND=FLASHMLA
DISABLE_CUSTOM_ALL_REDUCE=1
DISABLE_FLASHINFER_AUTOTUNE=1

# First qualification deliberately disables DSpark. Enable only after the
# 32-GPU base server, tool parser and Codex Responses path are stable.
SPECULATIVE_CONFIG=
# SPECULATIVE_CONFIG='{"model":"RedHatAI/Kimi-K3-speculator.dspark","num_speculative_tokens":8,"method":"dspark","draft_sample_method":"probabilistic","rejection_sample_method":"block"}'

NETWORK_IFACE=ib0
GLOO_SOCKET_IFNAME=ib0
NCCL_SOCKET_IFNAME=ib0
NCCL_DEBUG=INFO
NCCL_DMABUF_ENABLE=0
VLLM_ENGINE_READY_TIMEOUT_S=3600
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_RUST_FRONTEND=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Export HF_TOKEN in the shell if Hugging Face requires authentication.
