# Copy this file to config/deepseek-v4-pro.env on PCSS. Keep the real file
# untracked. All paths must be visible under the same name on every node.

MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813
MODEL_SUBDIR=DeepSeek-V4-Pro-0813
MODEL_ROOT=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/models
SIF=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/deepseek-v4-vllm.sif

MODEL_NAME=deepseek-v4-pro
SERVER_HOST=127.0.0.1
REMOTE_PORT=8001
LOCAL_PORT=18001
DP_RPC_PORT=13345

# First qualification profile: 4 PCSS nodes x 4 H100 = 16 DP/EP ranks.
# Increase SLURM_NNODES in sbatch to 8 if the 16-GPU run exhausts VRAM; the
# launcher derives total DP size from SLURM_NNODES automatically.
GPUS_PER_NODE=4
MAX_MODEL_LEN=200000
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.95
DTYPE=auto
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=256

ENABLE_EXPERT_PARALLEL=1
ENABLE_AUTO_TOOL_CHOICE=1
TOKENIZER_MODE=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4
REASONING_PARSER=deepseek_v4
SPECULATIVE_CONFIG='{"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"probabilistic"}'
COMPILATION_CONFIG='{"mode":0,"cudagraph_mode":"FULL_DECODE_ONLY"}'
DISABLE_FLASHINFER_AUTOTUNE=1

# Optional cluster-specific overrides. Leave unset for the first run and use
# NCCL_DEBUG=INFO to confirm whether PCSS selected InfiniBand/GDRDMA or sockets.
NCCL_DEBUG=INFO
# NCCL_SOCKET_IFNAME=ib0
# NCCL_IB_HCA=mlx5
# VLLM_HOST_IP is normally detected separately on every node. Do not set one
# shared value here; use it only while diagnosing per-node address selection.

# Optional Hugging Face token; export it in the shell instead of storing it.
# HF_TOKEN=
