# Ornith-1.5-35B-A3B in the official Ollama Q4 build: one PCSS H100.
MODEL_ID=ornith-1.5:35b
MODEL_NAME=ornith-1.5-35b
MODEL_ROOT=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/models/ornith15-ollama
SIF=/mnt/storage_3/home/kkingstoun/new_home/git/llm/qwen38-pcss/ornith15-ollama.sif

SERVER_HOST=127.0.0.1
REMOTE_PORT=8003
LOCAL_PORT=18003

CONTEXT_LENGTH=262144
FLASH_ATTENTION=1
KV_CACHE_TYPE=q8_0
KEEP_ALIVE=-1
MAX_LOADED_MODELS=1
NUM_PARALLEL=1

# Pull the 23 GB model automatically on the first job. The Ollama store is
# persistent under MODEL_ROOT, so later jobs only verify that the tag exists.
PULL_MODEL=1
# CONTAINER_RUNTIME=singularity
